{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "deal",
	"patterns": [
		{
			"include": "#keywords"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#comments"
		},
		{
			"include": "#types"
		},
		{
			"include": "#players"
		},
		{
			"include": "#cards"
		},
		{
			"include": "#functions"
		},
		{
			"include": "#properties"
		}
	],
	"repository": {
		"keywords": {
			"patterns": [{
				"name": "keyword.control.deal",
				"match": "\\b(if|cancel|else|on|define|for|in|return)\\b"
			}]
		},
		"functions": {
			"patterns": [
				{
					"name": "entity.name.function.deal",
					"match": "\\b(move|log|show|interact|win)\\b"
				},
				{
					"name": "entity.name.function.deal",
					"match": "(?<=\\s)[A-Za-z_]+(?=\\()"
				}
			]
		},
		"types": {
			"patterns": [
				{
					"name": "storage.type.deal",
					"match": "\\b(int|string|card|area|action|function)\\b"
				},
				{
					"name": "storage.type.deal",
					"match": "\\b(empty|jack|queen|king|ace|spades|hearts|diamonds|clubs|source|dest)\\b"
				}
			]
		},
		"strings": {
			"name": "string.quoted.double.deal",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
				"name": "support.type.primitive.deal",
				"match": "%[as]"
				}
			]
		},
		"comments": {
			"patterns": [
				{
					"name": "comment.line.double-slash",
					"match": "//.*$"
				}
			]
		},
		"players": {
			"patterns": [
				{
					"name": "support.type.primitive.deal",
					"match": "<[^>]*>"
				}
			]
		},
		"cards": {
			"patterns": [
				{
					"name": "constant.language.deal",
					"match": "#[A-Za-z0-9]+"
				}
			]
		},
		"properties": {
			"patterns": [
				{
					"name": "support.property-value",
					"match": "\\.[a-z]+"
				}
			]
		}
	},
	"scopeName": "source.deal"
}